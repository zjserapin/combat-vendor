# ---------------------------------------------------------------------------
# combat-vendor configuration. Copy to .env and edit. Never commit .env.
# Every value below has a working local default; you may not need a .env at all.
# ---------------------------------------------------------------------------

# --- LLM: "anthropic" locally, "bedrock" at Ally -----------------------------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium                 # low | medium | high | xhigh | max

# Optional if ANTHROPIC_KEY is already exported in your shell (it wins over this).
ANTHROPIC_API_KEY=

# Bedrock (Ally only) — uses the standard AWS credential chain / SSO profile.
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
AWS_REGION=us-east-1
AWS_PROFILE=

# --- Data: "duckdb" locally, "snowflake" at Ally ------------------------------
DB_BACKEND=duckdb
DUCKDB_PATH=data/cairn_bank.duckdb

# Snowflake (Ally only). Two roles: the harness writes the agent schema; the agent only SELECTs bank.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=                   # harness role (e.g. AML_POC_WRITER)
SNOWFLAKE_AGENT_ROLE=             # agent tools role, SELECT on bank only (e.g. AML_POC_READER)
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_AUTHENTICATOR=externalbrowser

# Schema names. Labels (human decisions) are kept apart so the agent can be denied them.
BANK_SCHEMA=bank
LABELS_SCHEMA=labels
AGENT_SCHEMA=agent

# --- Run ----------------------------------------------------------------------
AS_OF_DATE=2026-09-30             # synthetic bank's "today"; use "today" at Ally
SEED=42
ALERT_LOOKBACK_DAYS=30            # queue alerts whose latest flagged activity is this recent

# Evidence pack (point-in-time: nothing later than window_end + EVIDENCE_AFTER_DAYS)
EVIDENCE_HISTORY_DAYS=90          # 90-day profile + counterparty history before the window
EVIDENCE_CONTEXT_DAYS=30          # largest-other-transactions lookback before the window
EVIDENCE_AFTER_DAYS=3             # activity an analyst could see after the window closed

# --- Agent ----------------------------------------------------------------------
BANK_NAME=Cairn Bank              # used in the system prompt
AGENT_MAX_STEPS=6                 # model calls per alert, including the decision
AGENT_MAX_SECONDS=120             # wall-clock budget per alert
AGENT_MAX_TOKENS=16000            # max output tokens per model call (thinking included)
TOOLS_STRICT=true                 # strict tool schemas; set false only if an endpoint rejects them
DISMISS_MIN_CONFIDENCE=0.6        # a DISMISS below this confidence is routed to a human

# --- Run & impact board ---------------------------------------------------------
TRIAGE_MAX_CONSECUTIVE_FAILURES=3 # stop a run if the model keeps failing
INPUT_USD_PER_MTOK=4.0            # model list price (Opus 5.5 on the Anthropic API); use your Bedrock rate
OUTPUT_USD_PER_MTOK=20.0
REVIEW_SAMPLE_RATE=0.10           # POLICY: share of agent dismissals a human still re-reviews
MANUAL_MINUTES_PER_ALERT=45       # ASSUMPTION: used only if handle time isn't recorded

# --- Backtest ---------------------------------------------------------------------
BACKTEST_HOLDOUT_SHARE=0.5        # share of labelled alerts held out; tune prompts on dev only
BACKTEST_SPLIT_SALT=split-v1      # changing this re-draws the dev/holdout split — only on purpose
